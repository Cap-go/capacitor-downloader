{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>Cap-go/.github:renovate-config"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "eslint"
      ],
      "matchManagers": [
        "npm"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": false,
      "matchUpdateTypes": [
        "digest",
        "minor",
        "patch"
      ],
      "enabled": false
    },
    {
      "description": "OkHttp 5.5 and later require compileSdk 37; keep OkHttp on 5.4 until the plugin moves to compileSdk 37.",
      "matchPackageNames": [
        "com.squareup.okhttp3:**"
      ],
      "allowedVersions": "<5.5.0"
    }
  ]
}
