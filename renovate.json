{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>Cap-go/.github:renovate-config"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "eslint"
      ],
      "matchManagers": [
        "npm"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": false,
      "matchUpdateTypes": [
        "digest",
        "minor",
        "patch"
      ],
      "enabled": false
    }
  ]
}
